{
  "name": "secret-vault",
  "private": true,
  "version": "0.0.0",
  "description": "Bóveda local para secretos y credenciales",
  "author": "Secret Vault",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "dev:api": "node server/index.mjs",
    "start:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "desktop:dev": "concurrently -k -s first \"npm run dev\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "desktop:build": "npm run build",
    "desktop:dist": "npm run desktop:build && electron-builder",
    "desktop:dist:win": "npm run desktop:build && electron-builder --win",
    "desktop:dist:mac": "npm run desktop:build && electron-builder --mac",
    "desktop:dist:linux": "npm run desktop:build && electron-builder --linux",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-character-count": "^3.30.2",
    "@tiptap/extension-code-block-lowlight": "^3.30.2",
    "@tiptap/extension-color": "^3.30.2",
    "@tiptap/extension-font-family": "^3.30.2",
    "@tiptap/extension-highlight": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-list-item": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-subscript": "^3.30.2",
    "@tiptap/extension-superscript": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extension-task-item": "^3.30.2",
    "@tiptap/extension-task-list": "^3.30.2",
    "@tiptap/extension-text-align": "^3.30.2",
    "@tiptap/extension-text-style": "^3.30.2",
    "@tiptap/extension-typography": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/markdown": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.75.0",
    "wait-on": "^8.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.secretvault.app",
    "productName": "Secret Vault",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "server/**/*", "package.json", "!node_modules/**/*"],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": { "target": ["dmg", "zip"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Utility" }
  }
}
