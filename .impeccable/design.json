      "html": "<div class=\"ds-card\"><div class=\"ds-card-head\"><span class=\"ds-card-icon\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><path d=\"M3 5h10M3 11h10\"/><path d=\"M5 5c1-1 3-1 4 0 1 1 3 1 4 0\"/></svg></span><div class=\"ds-card-meta\"><div class=\"ds-card-title\">API_KEY_PAYMENTS</div><div class=\"ds-card-sub\">Variable de entorno</div></div></div><div class=\"ds-row\"><svg class=\"ds-row-icon\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><rect x=\"3.5\" y=\"7.5\" width=\"9\" height=\"6\" rx=\"1.5\"/><path d=\"M5.5 7.5V5a2.5 2.5 0 0 1 5 0v2.5\"/></svg><code class=\"ds-row-value\">••••••••••</code></div></div>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:10px;padding:14px;border:1px solid var(--border);border-radius:14px;background:var(--card)}.ds-card-head{display:flex;align-items:flex-start;gap:8px}.ds-card-icon{display:flex;align-items:center;justify-content:center;width:32px;height:32px;flex-shrink:0;border-radius:8px;background:var(--muted);color:var(--muted-foreground)}.ds-card-icon svg{width:16px;height:16px}.ds-card-meta{min-width:0}.ds-card-title{font:500 14px/1.25 ui-sans-serif,system-ui,sans-serif;color:var(--foreground);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-card-sub{font:400 12px/1.25 ui-sans-serif,system-ui,sans-serif;color:var(--muted-foreground)}.ds-row{display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:8px;background:color-mix(in oklab,var(--muted) 50%,transparent)}.ds-row-icon{width:14px;height:14px;color:var(--muted-foreground);flex-shrink:0}.ds-row-value{flex:1;min-width:0;font:400 14px/1 ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;color:var(--foreground);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
