      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border:none;border-radius:8px;background:var(--primary);color:var(--primary-foreground);font:500 14px/1 ui-sans-serif,system-ui,sans-serif;white-space:nowrap;cursor:pointer;transition:background .15s,color .15s}.ds-btn-primary:hover{background:color-mix(in oklab,var(--primary) 80%,transparent)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent)}.ds-btn-primary svg{width:16px;height:16px}"
