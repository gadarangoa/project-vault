      "css": ".ds-field{position:relative;display:block;width:100%}.ds-input{width:100%;height:32px;padding:0 12px 0 32px;border:1px solid var(--input);border-radius:8px;background:var(--background);color:var(--foreground);font:400 14px/1 ui-sans-serif,system-ui,sans-serif;transition:border-color .15s,box-shadow .15s}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent)}.ds-icon{position:absolute;left:10px;top:50%;transform:translateY(-50%);width:14px;height:14px;color:var(--muted-foreground);pointer-events:none}"
